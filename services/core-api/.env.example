# Server
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=toor
DB_NAME=estate360-ai

# JWT Authentication
JWT_SECRET=estate360-jwt-secret-key-super-safe
JWT_REFRESH_SECRET=estate360-jwt-refresh-secret-key-super-safe
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# IoT Cloud Server Fetch Configuration
IOT_CLOUD_FETCH_ENABLED=true
IOT_CLOUD_API_URL=https://api.estate360-cloud.com
IOT_CLOUD_API_KEY=your_cloud_server_api_key_here
IOT_CLOUD_WORKER_PATH=/readings/workers
IOT_CLOUD_ENV_PATH=/readings/environment
